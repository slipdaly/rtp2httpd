msgid "Access & Advanced"
msgstr "访问与高级"

msgid "Auto restart after crash"
msgstr "程序崩溃后自动重启"

msgid "Basic Settings"
msgstr "基础设置"

msgid "Buffer Pool Max Size"
msgstr "缓冲池最大容量"

msgid "CORS Allow Origin"
msgstr "CORS 允许的源"

msgid "Config File Content"
msgstr "配置文件内容"

msgid "Default interface for upstream traffic. Leave empty to use routing table."
msgstr "上游流量默认使用的接口。留空则使用路由表。"

msgid "Edit the content of /etc/rtp2httpd.conf"
msgstr "编辑 /etc/rtp2httpd.conf 的内容"

msgid "Enabled"
msgstr "启用"

msgid "Grant UCI access for luci-app-rtp2httpd-minimal"
msgstr "为 luci-app-rtp2httpd-minimal 授予 UCI 的访问权限"

msgid "Hostname"
msgstr "主机名/域名"

msgid "If set, all HTTP requests must include matching r2h-token query parameter."
msgstr "设置后，所有 HTTP 请求都必须带匹配的 r2h-token 查询参数。"

msgid "Interface to use for multicast RTP/UDP upstream traffic (default: use routing table)"
msgstr "用于组播 RTP/UDP 上游流量的接口（默认：使用路由表）"

msgid "Logging level"
msgstr "日志级别"

msgid "Max clients allowed"
msgstr "最大客户端数"

msgid "Maximum number of buffers in zero-copy pool. Each buffer is 1536 bytes."
msgstr "零拷贝缓冲池的最大缓冲区数量。每个缓冲区 1536 字节。"

msgid "Minimal rtp2httpd build for direct RTP/UDP to HTTP streaming. Unsupported features such as status UI, player, M3U/EPG, RTSP, HTTP proxy, snapshot, FCC and FEC are intentionally hidden."
msgstr "这是面向直接 RTP/UDP 转 HTTP 的精简版 rtp2httpd。状态页、播放器、M3U/EPG、RTSP、HTTP 代理、快照、FCC 和 FEC 等不支持的功能已刻意隐藏。"

msgid "Multicast Rejoin Interval"
msgstr "组播周期性重新加入间隔"

msgid "Network & Performance"
msgstr "网络与性能"

msgid "Periodic multicast rejoin interval in seconds (0=disabled, default 0)."
msgstr "周期性重新加入组播组的间隔时间（秒），0 表示禁用（默认 0）。"

msgid "Port"
msgstr "端口"

msgid "R2H Token"
msgstr "HTTP 请求认证令牌"

msgid "Respawn"
msgstr "自动重启"

msgid "Set Access-Control-Allow-Origin header to enable CORS. Leave empty to disable."
msgstr "设置 Access-Control-Allow-Origin 响应头以启用 CORS。留空则禁用。"

msgid "UDP Receive Buffer Size"
msgstr "UDP 接收缓冲区大小"

msgid "UDP socket receive buffer size in bytes for multicast traffic."
msgstr "组播流量使用的 UDP 套接字接收缓冲区大小（字节）。"

msgid "Upstream Interface"
msgstr "上游接口"

msgid "Upstream Multicast Interface"
msgstr "上游组播接口"

msgid "Use Config File"
msgstr "使用配置文件"

msgid "Use X-Forwarded-For and related proxy headers when running behind a reverse proxy."
msgstr "在反向代理后运行时，使用 X-Forwarded-For 及相关代理头。"

msgid "Use config file instead of individual options"
msgstr "使用配置文件而不是单独的选项"

msgid "When configured, HTTP Host header must match this value to allow access."
msgstr "配置后，HTTP Host 头必须匹配这里的值才能访问。"

msgid "Workers"
msgstr "工作进程数"

msgid "X-Forwarded-For"
msgstr "X-Forwarded-For"

msgid "Zero-Copy on Send"
msgstr "启用零拷贝发送"

msgid "Enable zero-copy send with MSG_ZEROCOPY for better performance."
msgstr "启用 MSG_ZEROCOPY 零拷贝发送以提升性能。"

msgid "Number of worker processes. Set to 1 for resource-constrained devices."
msgstr "工作进程数量。资源紧凑设备建议设置为 1。"

msgid "rtp2httpd"
msgstr "rtp2httpd"
